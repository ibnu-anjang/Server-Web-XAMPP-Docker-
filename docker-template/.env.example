# Ganti nilai ini sesuai nama project kamu
PROJECT_NAME=nama-project-kamu

# Port yang bisa diakses di browser (semua terikat localhost, tidak exposed ke network luar)
APP_PORT=8080
PMA_PORT=8081
DB_PORT=3306

# UID/GID host kamu — samakan permission file antar host & container agar tidak conflict.
# Cek dengan: id -u && id -g
HOST_UID=1000
HOST_GID=1000

# Kredensial database
DB_ROOT_PASS=rootsecret
DB_NAME=nama_database
DB_USER=dbuser
DB_PASS=dbpassword